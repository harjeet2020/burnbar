# Burnbar environment template
# ─────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# The real `.env` is gitignored and must NEVER be committed — it holds
# secrets for YOUR personal Supabase project and OpenRouter account.
# This template (committed) only documents which variables exist.
# ─────────────────────────────────────────────────────────────────────────

# Your Supabase project URL.
# Find it: Supabase dashboard → Project Settings → API → "Project URL"
# (looks like https://<project-ref>.supabase.co)
SUPABASE_URL=

# The public "anon" API key for your Supabase project. Safe-ish to expose
# to your own devices (RLS restricts it to read-only), but keep it out of
# git anyway. Used by the frontends (TUI / macOS app) — not needed for
# backend deploys.
# Find it: Supabase dashboard → Project Settings → API Keys → "anon public"
SUPABASE_ANON_KEY=

# Your regular OpenRouter inference API key. Used locally by
# scripts/test-request.sh and by the frontends to poll the credits
# endpoint. Never sent to the backend.
# Create one: https://openrouter.ai/settings/keys → "Create API Key"
OPENROUTER_API_KEY=

# Shared secret authenticating OpenRouter Broadcast → your edge function.
# Generate your own random value:
#
#     openssl rand -hex 32
#
# The same value goes in TWO other places:
#   1. Supabase edge function secret:
#        supabase secrets set BURNBAR_WEBHOOK_SECRET=<value>
#   2. OpenRouter Broadcast destination → custom header:
#        X-Burnbar-Secret: <value>
BURNBAR_WEBHOOK_SECRET=
